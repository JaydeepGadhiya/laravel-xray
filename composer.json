{
    "name": "larapack/laravel-xray",
    "description": "Analyze and understand large Laravel applications through architecture visualization and dead code detection.",
    "keywords": ["laravel", "architecture", "analysis", "dead-code", "visualization", "xray", "static-analysis"],
    "license": "MIT",
    "authors": [
        {
            "name": "Jaydeep Gadhiya",
            "email": "jaydeep@example.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/larapack/laravel-xray",
    "support": {
        "issues": "https://github.com/larapack/laravel-xray/issues",
        "source": "https://github.com/larapack/laravel-xray"
    },
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2|^8.3|^8.4",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Larapack\\Xray\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larapack\\Xray\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larapack\\Xray\\LaravelXrayServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
